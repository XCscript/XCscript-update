local function makeToggle(tab, text, key, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 38)
    btn.BackgroundColor3 = XC[key] and XC.Accent or Color3.fromRGB(28, 28, 36)
    btn.Text = text .. (XC[key] and "  •  ON" or "  •  OFF")
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(235, 235, 245)
    btn.Parent = Panels[tab]
    corner(btn, 8)
    local st = stroke(btn, XC[key] and XC.Accent or Color3.fromRGB(45, 45, 60))

    btn.MouseButton1Click:Connect(function()
        XC[key] = not XC[key]
        btn.BackgroundColor3 = XC[key] and XC.Accent or Color3.fromRGB(28, 28, 36)
        st.Color = XC[key] and XC.Accent or Color3.fromRGB(45, 45, 60)
        btn.Text = text .. (XC[key] and "  •  ON" or "  •  OFF")
        if callback then callback(XC[key]) end
    end)
    return btn
end

