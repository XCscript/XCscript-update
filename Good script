-- ================= ENGINE =================
local FOV = Drawing.new("Circle")
FOV.Thickness = 1
FOV.NumSides = 64
FOV.Filled = false
FOV.Color = XC.Accent

local function getTarget()
    local closest, shortest = nil, XC.FOVRadius
    local mousePos = UserInputService:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

local function hotkeyDown()
    if XC.IsBinding then return false end
    if typeof(XC.AimHotkey) == "EnumItem" and string.find(tostring(XC.AimHotkey), "KeyCode") then
        return UserInputService:IsKeyDown(XC.AimHotkey)
    else
        return UserInputService:IsMouseButtonPressed(XC.AimHotkey)
    end
end

-- ========== FIXED MOUSE AIMBOT ==========
local function moveMouse(to, hard)
    local viewport = Camera.ViewportSize
    local current = UserInputService:GetMouseLocation()

    -- Clamp target so it can never leave the game window
    local targetX = math.clamp(to.X, 5, viewport.X - 5)
    local targetY = math.clamp(to.Y, 5, viewport.Y - 5)

    local deltaX = targetX - current.X
    local deltaY = targetY - current.Y

    local mult = hard and 0.88 or XC.MouseSmoothness

    -- Limit max movement per frame (kills twitching)
    local maxMove = hard and 42 or 22
    deltaX = math.clamp(deltaX * mult, -maxMove, maxMove)
    deltaY = math.clamp(deltaY * mult, -maxMove, maxMove)

    -- Deadzone
    if math.abs(deltaX) < 1.5 then deltaX = 0 end
    if math.abs(deltaY) < 1.5 then deltaY = 0 end

    if mousemoverel then
        mousemoverel(deltaX, deltaY)
    end
end

-- Box ESP
local Boxes = {}

local function clearBoxes()
    for _, v in pairs(Boxes) do
        if v.Box then v.Box:Remove() end
        if v.Name then v.Name:Remove() end
    end
    table.clear(Boxes)
end

local function updateBoxESP()
    clearBoxes()
    if not XC.BoxESP then return end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local root = plr.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local size = 40 * (1 / (pos.Z / 20))
                    size = math.clamp(size, 12, 80)

                    local box = Drawing.new("Square")
                    box.Visible = true
                    box.Color = XC.Accent
                    box.Thickness = 1
                    box.Filled = false
                    box.Size = Vector2.new(size * 0.8, size * 1.5)
                    box.Position = Vector2.new(pos.X - (size * 0.4), pos.Y - (size * 0.9))

                    local name = Drawing.new("Text")
                    name.Visible = true
                    name.Text = plr.Name
                    name.Color = Color3.fromRGB(255, 255, 255)
                    name.Size = 13
                    name.Center = true
                    name.Outline = true
                    name.Position = Vector2.new(pos.X, pos.Y - (size * 1.05))

                    Boxes[plr] = {Box = box, Name = name}
                end
            end
        end
    end
end

-- Wall Delete (click to delete)
Mouse.Button1Down:Connect(function()
    if XC.WallDeleteMode and Mouse.Target then
        local part = Mouse.Target
        if part:IsA("BasePart") then
            local model = part:FindFirstAncestorOfClass("Model")
            if not model or not model:FindFirstChildOfClass("Humanoid") then
                part:Destroy()
            end
        end
