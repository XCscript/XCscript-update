end)

-- Main Loop
RunService.RenderStepped:Connect(function()
    FOV.Position = UserInputService:GetMouseLocation()
    FOV.Radius = XC.FOVRadius
    FOV.Color = XC.Accent
    FOV.Visible = Main.Visible and (XC.Aimbot or XC.MouseAimbot) and XC.ShowFOV

    if (XC.Aimbot or XC.MouseAimbot) and hotkeyDown() then
        local target = getTarget()
        if target and target.Character and target.Character:FindFirstChild("Head") then
            local head = target.Character.Head
            local screen, onScreen = Camera:WorldToViewportPoint(head.Position)

            if onScreen and screen.Z > 0 then
                local screenPos = Vector2.new(screen.X, screen.Y)

                if XC.MouseAimbot then
                    moveMouse(screenPos, XC.MouseHardLock)
                end

                if XC.Aimbot then
                    if XC.StickyLock then
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                    else
                        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, head.Position), 0.35)
                    end
                end
            end
        end
    end

    if XC.Speed and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 160 end
    end

    updateBoxESP()
end)

-- Highlight ESP
local function setupHighlight(plr)
    if plr == LocalPlayer then return end
    local function apply(char)
        local hl = Instance.new("Highlight")
        hl.FillTransparency = 0.7
        hl.OutlineTransparency = 0.2
        hl.Adornee = char
        hl.Parent = char
        RunService.RenderStepped:Connect(function()
            if not char.Parent or not hl then return end
            hl.Enabled = XC.ESP
            hl.FillColor = XC.Accent
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        end)
    end
    plr.CharacterAdded:Connect(apply)
    if plr.Character then apply(plr.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do setupHighlight(p) end
Players.PlayerAdded:Connect(setupHighlight)

