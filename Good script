local function createTab(name)
    local panel = Instance.new("ScrollingFrame")
    panel.Size = UDim2.new(1, 0, 1, 0)
    panel.BackgroundTransparency = 1
    panel.Visible = false
    panel.CanvasSize = UDim2.new(0, 0, 0, 420)
    panel.ScrollBarThickness = 3
    panel.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 100)
    panel.Parent = Content

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 7)
    list.Parent = panel
    Panels[name] = panel

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 100, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    btn.Text = name
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(160, 160, 175)
    btn.Parent = Side
    corner(btn, 8)
    local st = stroke(btn, Color3.fromRGB(45, 45, 60))

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Panels) do p.Visible = false end
        for _, b in pairs(Tabs) do
            b.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
            b.TextColor3 = Color3.fromRGB(160, 160, 175)
            b:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(45, 45, 60)
        end
        panel.Visible = true
        btn.BackgroundColor3 = XC.Accent
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        st.Color = XC.Accent
    end)

    Tabs[name] = btn
end

